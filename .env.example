NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local dev and Vercel preview deployments: leave this false so they never
# get indexed. In the Vercel project's Production environment variables
# only, set NEXT_PUBLIC_ALLOW_INDEXING=true and NEXT_PUBLIC_SITE_URL to the
# confirmed production origin.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Optional. Leave unset locally and on preview deployments so test traffic
# never reaches real analytics. Google Analytics only loads in the browser
# when this is set AND the visitor has chosen "Allow optional analytics" in
# the footer's Cookie preferences — never unconditionally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
