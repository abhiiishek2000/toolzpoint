NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local dev and Vercel preview deployments: leave this false so they never
# get indexed. In the Vercel project's Production environment variables
# only, set NEXT_PUBLIC_ALLOW_INDEXING=true and NEXT_PUBLIC_SITE_URL to the
# confirmed production origin.
NEXT_PUBLIC_ALLOW_INDEXING=false
